{% liquid
  assign card_index = index | default: 1
  assign card_heading = heading_tag | default: 'h3'
  assign variant = product.selected_or_first_available_variant
  assign secondary_image = product.images[1]
  assign card_loading = 'lazy'
  assign card_fetchpriority = 'auto'
  if card_index <= 4
    assign card_loading = 'eager'
    assign card_fetchpriority = 'high'
  endif
%}

<article class="ralen-card" data-ralen-card>
  <div class="ralen-card__media"
  data-ralen-card-gallery
  data-card-image-1="{% if product.images[1] != blank %}{{ product.images[1] | image_url: width: 1200 }}{% endif %}"
  data-card-image-2="{% if product.images[2] != blank %}{{ product.images[2] | image_url: width: 1200 }}{% endif %}"
  data-card-image-3="{% if product.images[3] != blank %}{{ product.images[3] | image_url: width: 1200 }}{% endif %}"
  data-card-image-4="{% if product.images[4] != blank %}{{ product.images[4] | image_url: width: 1200 }}{% endif %}">
    <a class="ralen-card__media-link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
      {% if product.featured_image != blank %}
        {{ product.featured_image
          | image_url: width: 1200
          | image_tag:
            widths: '360, 540, 720, 900, 1200',
            sizes: '(min-width: 990px) 25vw, (min-width: 640px) 50vw, 100vw',
            loading: card_loading,
            fetchpriority: card_fetchpriority,
            class: 'ralen-card__image ralen-card__image--primary',
            alt: product.featured_image.alt | default: product.title
        }}
        {% if secondary_image != blank %}
          {{ secondary_image
            | image_url: width: 1200
            | image_tag:
              widths: '360, 540, 720, 900, 1200',
              sizes: '(min-width: 990px) 25vw, (min-width: 640px) 50vw, 100vw',
              loading: 'lazy',
              class: 'ralen-card__image ralen-card__image--secondary',
              alt: secondary_image.alt | default: product.title
          }}
        {% endif %}
      {% else %}
        <div class="ralen-card__empty-media" aria-hidden="true"></div>
      {% endif %}

      <span class="ralen-card__number">{{ card_index | prepend: '0' }}</span>
      {% unless product.available %}<span class="ralen-card__status">AGOTADO</span>{% endunless %}
    </a>

    {% if show_quick_add %}
      <div class="ralen-card__quick">
        {% if product.available and product.has_only_default_variant %}
          <form method="post" action="{{ routes.cart_add_url }}" data-ralen-quick-add>
            <input type="hidden" name="id" value="{{ variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" data-ralen-quick-add-button>
              <span data-ralen-quick-add-label>AÑADIR</span><span aria-hidden="true">＋</span>
            </button>
          </form>
        {% elsif product.available %}
          <a href="{{ product.url }}" class="ralen-card__options">VER OPCIONES <span aria-hidden="true">→</span></a>
        {% endif %}
      </div>
    {% endif %}
  </div>

  <div class="ralen-card__meta">
    <div>
      <{{ card_heading }}><a href="{{ product.url }}">{{ product.title }}</a></{{ card_heading }}>
      {% if show_vendor and product.vendor != blank %}
        <span>{{ product.vendor }}</span>
      {% else %}
        <span>RALEN / RUN</span>
      {% endif %}
    </div>
    <div class="ralen-card__price">
      {% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }} MXN</s>{% endif %}
      <strong>{{ product.price | money }} MXN</strong>
    </div>
  </div>
</article>
