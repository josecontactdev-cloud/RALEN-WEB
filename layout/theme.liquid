<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#050505">

    <title>
      {{ page_title }}{% if current_tags %} — {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} — Página {{ current_page }}{% endif %}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}
    {% render 'ralen-meta' %}

    {{ content_for_header }}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'phase-2.css' | asset_url | stylesheet_tag }}
    {{ 'phase-2-footer.css' | asset_url | stylesheet_tag }}
    {{ 'phase-4.css' | asset_url | stylesheet_tag }}
    {{ 'phase-4-a11y.css' | asset_url | stylesheet_tag }}
    {{ 'phase-5.css' | asset_url | stylesheet_tag }}
    {{ 'phase-5-newsletter.css' | asset_url | stylesheet_tag }}
    {{ 'phase-6.css' | asset_url | stylesheet_tag }}

    {% case request.page_type %}
      {% when 'index' %}
        {{ 'phase-3-home.css' | asset_url | stylesheet_tag }}
        {{ 'phase-7.css' | asset_url | stylesheet_tag }}
      {% when 'product' %}
        {{ 'phase-3-product.css' | asset_url | stylesheet_tag }}
        {{ 'phase-4-mobile-buy.css' | asset_url | stylesheet_tag }}
      {% when 'cart' %}
        {{ 'phase-3-cart.css' | asset_url | stylesheet_tag }}
      {% when 'collection' %}
        {{ 'phase-3-collection.css' | asset_url | stylesheet_tag }}
      {% when 'search' %}
        {{ 'phase-4-search.css' | asset_url | stylesheet_tag }}
    {% endcase %}
    {% if request.page_type == 'page' and template.suffix == 'contact' %}
      {{ 'phase-4-contact.css' | asset_url | stylesheet_tag }}
    {% endif %}

    <script>document.documentElement.classList.remove('no-js');document.documentElement.classList.add('js');</script>
    {% if request.page_type == 'index' %}
      <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js" defer></script>
      <script src="{{ 'ralen.js' | asset_url }}" defer></script>
      <script src="{{ 'phase-7.js' | asset_url }}" defer></script>
    {% endif %}
    {% if request.page_type == 'product' %}
      <script src="{{ 'phase-3.js' | asset_url }}" defer></script>
    {% endif %}
    <script src="{{ 'phase-4.js' | asset_url }}" defer></script>
    <script src="{{ 'phase-5.js' | asset_url }}" defer></script>
    <script src="{{ 'phase-6.js' | asset_url }}" defer></script>
  </head>

  <body class="ralen-theme">
    <a class="skip-link" href="#MainContent">Saltar al contenido</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
    {% section 'ralen-cart-drawer' %}
  </body>
</html>
