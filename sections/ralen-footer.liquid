<footer class="ralen-footer" data-ralen-reveal>
  <div class="ralen-shell ralen-footer__top">
    <div>
      <a class="ralen-footer__brand" href="{{ routes.root_url }}">{{ section.settings.logo_text | default: shop.name }}</a>
      <p>{{ section.settings.tagline }}</p>
    </div>

    <div class="ralen-footer__links">
      {% if section.settings.menu != blank %}
        <nav aria-label="Enlaces del pie">
          {% for link in section.settings.menu.links %}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {% endfor %}
        </nav>
      {% endif %}

      {% if shop.privacy_policy != blank or shop.refund_policy != blank or shop.shipping_policy != blank or shop.terms_of_service != blank %}
        <nav aria-label="Políticas de la tienda">
          {% if shop.shipping_policy != blank %}<a href="{{ shop.shipping_policy.url }}">Envíos</a>{% endif %}
          {% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}">Devoluciones</a>{% endif %}
          {% if shop.privacy_policy != blank %}<a href="{{ shop.privacy_policy.url }}">Privacidad</a>{% endif %}
          {% if shop.terms_of_service != blank %}<a href="{{ shop.terms_of_service.url }}">Términos</a>{% endif %}
        </nav>
      {% endif %}

      {% if section.settings.email != blank %}<a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>{% endif %}
    </div>
  </div>

  <div class="ralen-shell ralen-footer__bottom">
    <span>© {{ 'now' | date: '%Y' }} RALEN</span>
    <span>MÉXICO</span>
  </div>
</footer>

{% schema %}
{
  "name": "RALEN Footer",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo", "default": "RALEN" },
    { "type": "text", "id": "tagline", "label": "Frase", "default": "Objetos para hacer mejor lo cotidiano." },
    { "type": "link_list", "id": "menu", "label": "Menú" },
    { "type": "text", "id": "email", "label": "Email" }
  ]
}
{% endschema %}
