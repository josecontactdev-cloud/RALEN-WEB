<section class="ralen-signal ralen-signal--reviews" aria-label="Reseñas de RALEN RUN">
  <div class="ralen-signal__viewport">
    <div class="ralen-signal__track" aria-hidden="true">
      {% for repeat in (1..4) %}
        <div class="ralen-signal__group">
          <span class="ralen-signal__review">
            <strong aria-hidden="true">★★★★★</strong>
            <em>{{ section.settings.review_label }}</em>
            <b>{{ section.settings.review_cta }}</b>
          </span>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RALEN Reviews Signal",
  "settings": [
    { "type": "text", "id": "review_label", "label": "Etiqueta de reseñas", "default": "REVIEWS / RUN 001" },
    { "type": "text", "id": "review_cta", "label": "Texto secundario", "default": "LEER OPINIONES" }
  ],
  "presets": [{ "name": "RALEN Reviews Signal" }]
}
{% endschema %}
