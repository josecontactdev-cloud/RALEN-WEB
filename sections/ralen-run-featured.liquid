{% assign product = all_products[section.settings.product] %}
<section class="ralen-run-featured" id="RalenRun001" data-ralen-reveal>
  <div class="ralen-shell">
    <div class="ralen-run-featured__head">
      <span>{{ section.settings.index_label }}</span>
      <div>
        <p>{{ section.settings.kicker }}</p>
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.copy != blank %}<div>{{ section.settings.copy }}</div>{% endif %}
      </div>
    </div>

    {% if product != blank %}
      <a class="ralen-run-featured__product" href="{{ product.url }}">
        <div class="ralen-run-featured__media">
          {% if product.featured_image %}
            {{ product.featured_image | image_url: width: 1400 | image_tag: widths: '480, 720, 960, 1200, 1400', sizes: '100vw', loading: 'lazy', alt: product.title }}
          {% endif %}
          <span>RUN / 001</span>
        </div>
        <div class="ralen-run-featured__info">
          <div>
            <span>{{ section.settings.product_label }}</span>
            <h3>{{ product.title }}</h3>
          </div>
          <div class="ralen-run-featured__buy">
            <strong>{{ product.price | money }} MXN</strong>
            <span>{{ section.settings.cta }} <i aria-hidden="true">↗</i></span>
          </div>
        </div>
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "RALEN RUN / 001",
  "settings": [
    { "type": "text", "id": "index_label", "label": "Índice", "default": "03 / THE PIECE" },
    { "type": "text", "id": "kicker", "label": "Etiqueta", "default": "RALEN / RUN 001" },
    { "type": "text", "id": "heading", "label": "Título", "default": "ONE PIECE. ENOUGH TO MOVE." },
    { "type": "richtext", "id": "copy", "label": "Descripción", "default": "<p>La primera pieza de RALEN: técnica, minimalista y producida bajo demanda en México.</p>" },
    { "type": "product", "id": "product", "label": "Producto" },
    { "type": "text", "id": "product_label", "label": "Etiqueta de producto", "default": "PERFORMANCE TEE / MADE IN MX" },
    { "type": "text", "id": "cta", "label": "CTA", "default": "VER OPCIONES" }
  ],
  "presets": [{ "name": "RALEN RUN / 001" }]
}
{% endschema %}
