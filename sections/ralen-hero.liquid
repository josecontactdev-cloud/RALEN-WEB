{% liquid
  assign merchandising_mode = section.settings.merchandising_mode | default: 'manual'
  assign source_collection = section.settings.trend_collection
  assign rotation_limit = section.settings.rotation_limit | default: 6
  assign display_product = section.settings.featured_product
  assign source_label = 'MANUAL'

  if merchandising_mode != 'manual' and source_collection != blank and source_collection.products_count > 0
    assign source_label = 'COLECCIÓN'

    if merchandising_mode == 'collection_first'
      assign display_product = blank
      for candidate in source_collection.products limit: rotation_limit
        if candidate.available
          assign display_product = candidate
          break
        endif
      endfor
    elsif merchandising_mode == 'daily_rotation'
      assign source_label = 'ROTACIÓN DIARIA'
      assign candidate_count = source_collection.products_count | at_most: rotation_limit
      if candidate_count > 0
        assign day_number = 'now' | date: '%j' | plus: 0
        assign rotation_index = day_number | modulo: candidate_count
        assign display_product = source_collection.products[rotation_index]

        if display_product == blank or display_product.available == false
          assign display_product = blank
          for candidate in source_collection.products limit: rotation_limit
            if candidate.available
              assign display_product = candidate
              break
            endif
          endfor
        endif
      endif
    endif
  endif

  if display_product == blank
    assign display_product = section.settings.featured_product
    assign source_label = 'RESPALDO MANUAL'
  endif

  assign hero_link = section.settings.cta_link
  if display_product != blank
    assign hero_link = display_product.url
  endif

  assign hero_image = section.settings.image
  if merchandising_mode != 'manual' and display_product != blank and display_product.featured_image != blank
    assign hero_image = display_product.featured_image
  elsif hero_image == blank and display_product != blank and display_product.featured_image != blank
    assign hero_image = display_product.featured_image
  endif

  assign hero_alt = section.settings.heading
  if hero_image != blank and hero_image.alt != blank
    assign hero_alt = hero_image.alt
  elsif display_product != blank
    assign hero_alt = display_product.title
  endif
%}

<section
  class="ralen-hero"
  data-ralen-hero
  data-merchandising-mode="{{ merchandising_mode }}"
  {% if display_product != blank %}data-merchandising-product-id="{{ display_product.id }}"{% endif %}
  {% if source_collection != blank %}data-merchandising-collection="{{ source_collection.handle }}"{% endif %}
>
  <div class="ralen-shell ralen-hero__grid">
    <div class="ralen-hero__content">
      <div class="ralen-hero__index" aria-hidden="true">
        <span>{{ section.settings.slide_label }}</span>
        <span class="ralen-line"></span>
      </div>

      {% if section.settings.eyebrow != blank %}
        <p class="ralen-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      <h1 class="ralen-hero__title">{{ section.settings.heading }}</h1>

      {% if section.settings.copy != blank %}
        <div class="ralen-hero__copy">{{ section.settings.copy }}</div>
      {% endif %}

      {% if section.settings.cta_label != blank %}
        <a class="ralen-text-link" href="{{ hero_link | default: routes.all_products_collection_url }}">
          {{ section.settings.cta_label }}
          <span aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>

    <div class="ralen-hero__visual">
      <div class="ralen-hero__media">
        {% if hero_image != blank %}
          {{ hero_image
            | image_url: width: 1800
            | image_tag:
              widths: '640, 960, 1280, 1600, 1800',
              sizes: '(min-width: 990px) 62vw, 100vw',
              loading: 'eager',
              fetchpriority: 'high',
              class: 'ralen-hero__image',
              alt: hero_alt
          }}
        {% else %}
          <div class="ralen-hero__placeholder" aria-hidden="true">
            <span>PRODUCTO</span>
            <strong>01</strong>
          </div>
        {% endif %}
      </div>

      {% if section.settings.badge != blank %}
        <div class="ralen-hero__badge">
          <span>{{ section.settings.badge }}</span>
          <i></i>
        </div>
      {% endif %}

      {% if display_product != blank %}
        <a class="ralen-product-chip" href="{{ display_product.url }}" data-ralen-dynamic-product>
          {% if display_product.featured_image != blank %}
            {{ display_product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: display_product.title }}
          {% endif %}
          <span>
            <small>{{ section.settings.product_label | default: 'SELECCIÓN RALEN' }}</small>
            <strong>{{ display_product.title }}</strong>
            <em>{{ display_product.price | money }}</em>
          </span>
          <span aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>
  </div>

  <div class="ralen-shell ralen-hero__footer">
    <span>{{ section.settings.footer_note }}</span>
    <span>{{ source_label }} / MX / {{ 'now' | date: '%Y' }}</span>
  </div>

  <script type="application/json" data-ralen-merchandising-state>
    {
      "mode": {{ merchandising_mode | json }},
      "source": {{ source_label | json }},
      "collection_handle": {% if source_collection != blank %}{{ source_collection.handle | json }}{% else %}null{% endif %},
      "product_id": {% if display_product != blank %}{{ display_product.id | json }}{% else %}null{% endif %},
      "product_handle": {% if display_product != blank %}{{ display_product.handle | json }}{% else %}null{% endif %},
      "product_title": {% if display_product != blank %}{{ display_product.title | json }}{% else %}null{% endif %}
    }
  </script>
</section>

{% schema %}
{
  "name": "RALEN Hero",
  "settings": [
    {
      "type": "header",
      "content": "Merchandising dinámico"
    },
    {
      "type": "select",
      "id": "merchandising_mode",
      "label": "Modo del producto destacado",
      "options": [
        { "value": "manual", "label": "Manual" },
        { "value": "collection_first", "label": "Primero de una colección" },
        { "value": "daily_rotation", "label": "Rotación diaria" }
      ],
      "default": "manual"
    },
    {
      "type": "collection",
      "id": "trend_collection",
      "label": "Colección fuente",
      "info": "En modo dinámico, RALEN usa el orden de esta colección. Puedes ordenarla por más vendidos, novedades o manualmente."
    },
    {
      "type": "range",
      "id": "rotation_limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6,
      "label": "Productos candidatos"
    },
    {
      "type": "paragraph",
      "content": "Manual mantiene el comportamiento actual. Primero de una colección sigue su orden en Shopify. Rotación diaria alterna entre los primeros productos disponibles de esa colección. Si la fuente queda vacía, se usa el producto manual como respaldo."
    },
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "text",
      "id": "slide_label",
      "label": "Índice",
      "default": "01 / 01"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta",
      "default": "RALEN / SELECCIÓN ACTUAL"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Título",
      "default": "MEJOR, NO MÁS."
    },
    {
      "type": "richtext",
      "id": "copy",
      "label": "Descripción",
      "default": "<p>Objetos seleccionados por diseño, utilidad y función.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texto del botón",
      "default": "EXPLORAR TIENDA"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Enlace del botón"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen manual / respaldo"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Producto manual / respaldo"
    },
    {
      "type": "text",
      "id": "product_label",
      "label": "Etiqueta de producto",
      "default": "SELECCIÓN RALEN"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Etiqueta lateral",
      "default": "ELEGIDO CON CRITERIO"
    },
    {
      "type": "text",
      "id": "footer_note",
      "label": "Nota inferior",
      "default": "OBJETOS PARA HACER MEJOR LO COTIDIANO"
    }
  ],
  "presets": [
    {
      "name": "RALEN Hero"
    }
  ]
}
{% endschema %}
